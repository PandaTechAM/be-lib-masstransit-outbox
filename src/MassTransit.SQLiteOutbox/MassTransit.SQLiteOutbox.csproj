<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Pandatech.MassTransit.SQLiteOutbox</PackageId>
        <Description>Outbox and Inbox pattern implementation for MassTransit with SQLite and EF Core. Supports multiple DbContexts for modular monolith and microservice architectures. Uses a lease-based concurrency strategy compatible with SQLite's single-writer model. Wire-compatible with Pandatech.MassTransit.PostgresOutbox.</Description>
        <PackageTags>masstransit;outbox;inbox;sqlite;efcore;entity-framework;distributed-systems;modular-monolith;microservices;messaging;reliability</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MassTransit" Version="8.0.11"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0"/>
    </ItemGroup>

</Project>