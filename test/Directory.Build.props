<Project>
    <!-- Import the root Directory.Build.props (inherits analyzers, version, etc.) -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <!-- Override: test/demo projects target only net10.0 and are not packable -->
    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
</Project>
